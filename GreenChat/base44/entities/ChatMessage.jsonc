{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "chat_id": {
      "type": "string",
      "description": "sorted user ids for DM, or group_<id> for group chats"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_username": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "user ids allowed to read this message"
    }
  },
  "required": [
    "chat_id",
    "sender_id",
    "text",
    "participants"
  ],
  "rls": {
    "read": {
      "data.participants": "{{user.id}}"
    },
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "update": {
      "data.sender_id": "{{user.id}}"
    },
    "delete": {
      "data.sender_id": "{{user.id}}"
    }
  }
}