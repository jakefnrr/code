{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user id this profile belongs to"
    },
    "username": {
      "type": "string",
      "description": "Unique handle used for search and friend requests"
    },
    "display_name": {
      "type": "string",
      "description": "Friendly name shown in chats"
    },
    "bio": {
      "type": "string"
    },
    "avatar_color": {
      "type": "string",
      "description": "Hue used to render the initial-based avatar"
    }
  },
  "required": [
    "username"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}